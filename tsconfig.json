{
  "compilerOptions": {
    // ES2020, not ES5. Subclassing built-in Error under an ES5 target silently breaks
    // `instanceof`, so `catch (e) { if (e instanceof RateLimited) }` would never match —
    // exactly the code a caller writes to handle a 429.
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["index.ts", "test/**/*.ts"]
}
